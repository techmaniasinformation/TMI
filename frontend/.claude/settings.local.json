{
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(rm:*)",
      "Bash(find:*)",
      "Bash(git add:*)",
      "Bash(mv:*)",
      "Bash(if [ -f \"domain_components/ui/.gitkeep\" ])",
      "Bash(then mv domain_components/ui/.gitkeep components/ui/)",
      "Bash(fi)",
      "Bash(if [ -d \"domain_components/ui\" ])",
      "Bash([ -z \"$(ls -A domain_components/ui)\" ])",
      "Bash(then rmdir domain_components/ui)"
    ],
    "deny": []
  }
}